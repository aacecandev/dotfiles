# ── Secrets / private key material — NEVER commit ──────────────────────────
# SOPS age private key (decrypts every SOPS secret).
**/sops/age/keys.txt
*.age
# Generic secret files.
.secrets
.env
.env.*
# Private keys of any kind.
*.key
*.pem
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*_ed25519
# GnuPG private material — the .conf files ARE tracked, key material is not.
.gnupg/private-keys-v1.d/
.gnupg/openpgp-revocs.d/
.gnupg/*.key
.gnupg/random_seed
.gnupg/S.*
.gnupg/.#*
# Machine-local mise config (age-encrypted GITHUB_TOKEN); see docs/github-token.md.
mise.local.toml

# ── Runtime / build / tooling caches ───────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.atl/

# ── OS / editor noise ──────────────────────────────────────────────────────
.DS_Store
*.swp

**/.claude/settings.local.json

# ── Logs ───────────────────────────────────────────────────────────────────
logs/*
!logs/.gitkeep
