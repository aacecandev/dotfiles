# Template for mise.local.toml, the git-ignored, machine-local mise config.
#
# Before the first install (install.sh trusts and renders it):
#   cp mise.local.toml.example mise.local.toml
#   $EDITOR mise.local.toml
#   sh install.sh
#
# After installing, apply changes with:
#   mise trust mise.local.toml
#   mise dot apply ~/.config/git/config
#
# Every variable is documented in docs/private-settings.md. Unset or empty
# values render nothing. Never commit the real file: it holds personal data.

[vars]
# Needed to commit: git refuses to guess an identity (user.useConfigOnly).
git_name = "Your Name"
git_email = "you@example.com"

# Optional: SSH signing key. Use the .pub path (or "key::ssh-ed25519 AAAA...")
# when the key is loaded in ssh-agent, otherwise the private key path
# (~/.ssh/id_ed25519). Setting it also turns on commit signing.
# git_signingkey = "~/.ssh/id_ed25519.pub"

# Optional: host whose credentials git saves in plain text in
# ~/.git-credentials (helper = store).
# git_credential_url = "https://git.example.com"

# Only needed to run tests/run.sh: GITHUB_TOKEN, age-encrypted.
# Do not write it by hand; follow docs/github-token.md, which adds:
# [settings]
# experimental = true
# [env]
# GITHUB_TOKEN = { age = "..." }
