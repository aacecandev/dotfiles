# export PATH
# Prepend user toolchains so they take precedence over system binaries.
# Build the prefix preserving the order below, then prepend it once.
PATH_DIRS=(
    "${HOME}/.atuin/bin"
    "${HOME}/.cargo/bin"
    "${HOME}/.docker/bin"
    "${HOME}/.krew/bin"
    "${HOME}/.local/bin"
    "${HOME}/.local/share/pnpm/bin"
    "${HOME}/.opencode/bin"
    "${HOME}/bin"
    "${HOME}/go/bin"
)
PATH_PREFIX=""
for i in "${PATH_DIRS[@]}"; do
    [ -d "${i}" ] && PATH_PREFIX="${PATH_PREFIX:+${PATH_PREFIX}:}${i}"
done
[ -n "${PATH_PREFIX}" ] && PATH="${PATH_PREFIX}:${PATH}"
export PATH="${PATH}"
unset PATH_DIRS PATH_PREFIX

# pnpm
[ -d "${HOME}/.local/share/pnpm" ] && export PNPM_HOME="${HOME}/.local/share/pnpm"

# You may need to manually set your MANPATH
export MANPATH="/usr/local/man:${MANPATH}"

# You may need to manually set your language environment
export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
export EDITOR='nvim'
export VISUAL="${EDITOR}"

# homebrew stuff
if (type brew &>/dev/null); then
    export HOMEBREW_NO_ANALYTICS=1
    export HOMEBREW_NO_ASK=1
    export HOMEBREW_NO_ENV_HINTS=1
fi

# Docker stuff
export BUILDKIT_COLORS="run=light-blue:error=light-red:cancel=light-magenta:warning=light-yellow"

# .Net stuff
export DOTNET_CLI_TELEMETRY_OPTOUT=1

# fzf (Tab coexists with zsh-autocomplete: ** triggers fzf, otherwise falls through to autocomplete)
# https://github.com/junegunn/fzf#fuzzy-completion-for-bash-and-zsh
if (type fzf &>/dev/null); then
    # fzf restores options via eval, which fails without a TTY (zle off)
    [[ -t 0 ]] && source <(fzf --zsh 2>/dev/null)

    export FZF_DEFAULT_COMMAND="fd --type f --strip-cwd-prefix --hidden --follow --exclude '.git' --exclude 'node_modules' --one-file-system"

    export FZF_COLORS="--color=fg:#cdd6f4,fg+:#f9e2af,bg:#121212,bg+:#313244
    --color=hl:#5f87af,hl+:#5fd7ff,info:#afaf87,marker:#87ff00
    --color=preview-fg:#f5e0dc,preview-bg:#2E3440,label:#cba6f7,spinner:cyan
    --color=header:#cba6f7,prompt:#cba6f7,pointer:#cba6f7,scrollbar:#fab387"

    [ -n "${TMUX}" ] && FZF_TMUX_OPTS="--tmux center,90%"

    export FZF_DEFAULT_OPTS="${FZF_COLORS} ${FZF_TMUX_OPTS:-} --border='rounded'
    --border-label='' --preview-window='border-double'
    --bind='ctrl-p:change-preview-window(down|hidden|)'
    --marker='✘' --pointer='❯' --separator='─'
    --scrollbar='│' --cycle --ghost='Search..'"

    export FZF_CTRL_T_OPTS="--walker-skip .git,node_modules,target --preview 'bat -n --color=always {}'"
    export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude '.git' . | awk -F'/' '{print NF-1, \$0}' | sort -n | cut -d' ' -f2-"
    export FZF_COMPLETION_OPTS='--border --info=inline'
    export FZF_COMPLETION_DIR_COMMANDS="cd pushd rmdir tree"
    export FZF_COMPLETION_PATH_OPTS='--walker file,dir,follow,hidden --walker-skip .git,node_modules'
    export FZF_COMPLETION_DIR_OPTS='--walker dir,follow --walker-skip .git,node_modules'

    _fzf_comprun() {
        local command="${1}"
        shift
        case "${command}" in
            cd) fzf --preview 'tree -C {} | head -200' "$@" ;;
            export | unset) fzf --preview "eval 'echo \$'{}" "$@" ;;
            ssh) fzf --preview 'dig {}' "$@" ;;
            *) fzf --preview 'bat -n --color=always {}' "$@" ;;
        esac
    }
fi

######################################################################
# less tweaks
export LESS='-asrRix8'
export LESSCHARSET='utf-8'

# color manpage
export LESS_TERMCAP_mb=$'\E[01;31m'       # begin blinking
export LESS_TERMCAP_md=$'\E[01;38;5;208m' # begin bold
export LESS_TERMCAP_me=$'\E[0m'           # end mode
export LESS_TERMCAP_se=$'\E[0m'           # end standout-mode
export LESS_TERMCAP_so=$'\E[38;07;246m'   # begin standout-mode - info box
export LESS_TERMCAP_ue=$'\E[0m'           # end underline
export LESS_TERMCAP_us=$'\E[04;38;5;111m' # begin underline

######################################################################
# auto completion

# zoxide init
(type zoxide &>/dev/null) && eval "$(zoxide init zsh)"

# worktrunk init
if command -v wt &>/dev/null; then
    wt_command="$(command -v wt)"
    if [[ "${wt_command}" == *bin* ]]; then
        wt_cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/zsh"
        wt_cache_file="${wt_cache_dir}/worktrunk-init.zsh"
        if [[ ! -r "${wt_cache_file}" || "${wt_command}" -nt "${wt_cache_file}" ]]; then
            mkdir -p "${wt_cache_dir}" && command wt config shell init zsh >|"${wt_cache_file}"
        fi
        [ -r "${wt_cache_file}" ] && source "${wt_cache_file}"
    fi
    unset wt_command wt_cache_dir wt_cache_file
fi


######################################################################
# load zsh sources

DEFAULT_SOURCES=(
    "${HOME}/.aliases"
    "${HOME}/.aliases_custom"
    "${HOME}/.aliases_work"
    "${HOME}/.functions"
    "${HOME}/.functions_custom"
    "${HOME}/.zshrc_custom"
    "${HOME}/.exports"
    "${HOME}/.secrets"
)

for file in "${DEFAULT_SOURCES[@]}"; do
    [ -r "${file}" ] && source "${file}"
done
unset file DEFAULT_SOURCES

######################################################################
# -- DO NOT EDIT THIS FILE --
# Add your customizations in ~/.zshrc_custom and they will
# be loaded automatically when you start a new shell session.
######################################################################
