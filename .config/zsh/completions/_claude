#compdef claude

# Completion for Claude Code CLI.
# Autoloaded via fpath (~/.zsh/completions/_claude), so it uses the
# #compdef directive — NOT compdef registration.

_claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a global_opts=(
    '(-h --help)'{-h,--help}'[Display help for command]'
    '(-v --version)'{-v,--version}'[Output the version number]'
    '(-c --continue)'{-c,--continue}'[Continue the most recent conversation in the current directory]'
    '*--add-dir[Additional directories to allow tool access to]:directory:_directories'
    '--agent[Agent for the current session]:agent:'
    '--agents[JSON object defining custom agents]:json:'
    '--allow-dangerously-skip-permissions[Enable bypassing all permission checks as an option]'
    '*--allowedTools[Tools to allow (e.g. "Bash(git *) Edit")]:tools:'
    '*--allowed-tools[Tools to allow (e.g. "Bash(git *) Edit")]:tools:'
    '--append-system-prompt[Append a system prompt to the default system prompt]:prompt:'
    '--ax-screen-reader[Render screen-reader friendly output]'
    '--bare[Minimal mode: skip hooks, LSP, plugin sync, auto-memory, etc.]'
    '*--betas[Beta headers to include in API requests (API key users only)]:betas:'
    '--brief[Enable SendUserMessage tool for agent-to-user communication]'
    '--chrome[Enable Claude in Chrome integration]'
    '--dangerously-skip-permissions[Bypass all permission checks]'
    '(-d --debug)'{-d,--debug}'[Enable debug mode with optional category filtering]::filter:'
    '--debug-file[Write debug logs to a specific file path]:path:_files'
    '--disable-slash-commands[Disable all skills]'
    '*--disallowedTools[Tools to deny (e.g. "Bash(git *) Edit")]:tools:'
    '*--disallowed-tools[Tools to deny (e.g. "Bash(git *) Edit")]:tools:'
    '--effort[Effort level for the current session]:level:(low medium high xhigh max)'
    '--exclude-dynamic-system-prompt-sections[Move per-machine sections into the first user message]'
    '*--fallback-model[Fallback model(s) when default is overloaded (--print only)]:model:'
    '*--file[File resources to download at startup (file_id:relative_path)]:spec:'
    '--fork-session[On resume, create a new session ID instead of reusing the original]'
    '--from-pr[Resume a session linked to a PR by number/URL, or open picker]::value:'
    '--ide[Automatically connect to IDE on startup if exactly one is available]'
    '--include-hook-events[Include all hook lifecycle events (stream-json only)]'
    '--include-partial-messages[Include partial message chunks (--print, stream-json)]'
    '--input-format[Input format (--print only)]:format:(text stream-json)'
    '--json-schema[JSON Schema for structured output validation]:schema:'
    '--max-budget-usd[Maximum dollar amount to spend on API calls (--print only)]:amount:'
    '*--mcp-config[Load MCP servers from JSON files or strings]:config:_files'
    '--mcp-debug[Enable MCP debug mode (DEPRECATED, use --debug)]'
    '--model[Model for the current session]:model:(opus sonnet fable haiku)'
    '(-n --name)'{-n,--name}'[Set a display name for this session]:name:'
    '--no-chrome[Disable Claude in Chrome integration]'
    '--no-session-persistence[Disable session persistence (--print only)]'
    '--output-format[Output format (--print only)]:format:(text json stream-json)'
    '--permission-mode[Permission mode to use for the session]:mode:(acceptEdits auto bypassPermissions default dontAsk plan)'
    '*--plugin-dir[Load a plugin from a directory or .zip for this session only]:path:_files'
    '*--plugin-url[Fetch a plugin .zip from a URL for this session only]:url:'
    '(-p --print)'{-p,--print}'[Print response and exit (useful for pipes)]'
    '--prompt-suggestions[Enable prompt suggestions]::value:(true false 1 0 yes no on off)'
    '--remote-control[Start an interactive session with Remote Control enabled]::name:'
    '--remote-control-session-name-prefix[Prefix for auto-generated Remote Control session names]:prefix:'
    '--replay-user-messages[Re-emit user messages from stdin back on stdout]'
    '(-r --resume)'{-r,--resume}'[Resume a conversation by session ID, or open picker]::value:'
    '--safe-mode[Start with all customizations disabled (troubleshooting)]'
    '--session-id[Use a specific session ID (must be a valid UUID)]:uuid:'
    '--setting-sources[Comma-separated setting sources to load]:sources:'
    '--settings[Path to a settings JSON file or a JSON string]:file:_files'
    '--strict-mcp-config[Only use MCP servers from --mcp-config]'
    '--system-prompt[System prompt to use for the session]:prompt:'
    '--tmux[Create a tmux session for the worktree (requires --worktree)]'
    '*--tools[Available tools from the built-in set (or "" / "default")]:tools:'
    '--verbose[Override verbose mode setting from config]'
    '(-w --worktree)'{-w,--worktree}'[Create a new git worktree for this session]::name:'
  )

  _arguments -C \
    "${global_opts[@]}" \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      local -a subcommands=(
        'agents:Manage background agents'
        'auth:Manage authentication'
        'auto-mode:Inspect auto mode classifier configuration'
        'doctor:Check the health of your Claude Code auto-updater'
        'install:Install Claude Code native build'
        'mcp:Configure and manage MCP servers'
        'plugin:Manage Claude Code plugins'
        'plugins:Manage Claude Code plugins'
        'project:Manage Claude Code project state'
        'setup-token:Set up a long-lived authentication token'
        'ultrareview:Run a cloud-hosted multi-agent code review'
        'update:Check for updates and install if available'
        'upgrade:Check for updates and install if available'
      )
      _describe -t commands 'claude command' subcommands
      ;;
    args)
      case ${line[1]} in
        install)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '1:target:(stable latest)'
          ;;
        ultrareview)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '1:target (PR number / base branch):'
          ;;
        update|upgrade|doctor|auto-mode|setup-token)
          _arguments '(-h --help)'{-h,--help}'[Display help for command]'
          ;;
        agents|auth|mcp|plugin|plugins|project)
          # Subcommands not enumerated in --help; offer help flag.
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '*::arg:_default'
          ;;
        *)
          _default
          ;;
      esac
      ;;
  esac
}

_claude "$@"
